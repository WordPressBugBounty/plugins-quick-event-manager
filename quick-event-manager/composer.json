{
    "name": "brightplugins/quick-event-manager",
    "description": "A quick and easy to use Event Manager for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "homepage": "https://brightplugins.com/",
    "authors": [
        {
            "name": "Bright Plugins",
            "homepage": "https://brightplugins.com/"
        }
    ],
    "require": {
        "php": ">=7.4",
        "composer/installers": "^1.0",
        "freemius/wordpress-sdk": "^2.12",
        "alanef/fullworks-template-loader-lib": "dev-master"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.0",
        "squizlabs/php_codesniffer": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
